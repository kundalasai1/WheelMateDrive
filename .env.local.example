# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=

# Authentication (generate with: openssl rand -base64 32)
AUTH_SECRET=
SESSION_COOKIE_NAME=wheelmate_session

# Google Maps Platform
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=WheelMateDrive <noreply@yourdomain.com>
SUPPORT_EMAIL=support@yourdomain.com

# Cloudinary image uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# WhatsApp Cloud API (optional; integration-ready)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Company / GST invoice details
COMPANY_LEGAL_NAME=WheelMateDrive Private Limited
COMPANY_GSTIN=
COMPANY_ADDRESS=
COMPANY_STATE_CODE=

# Demo administrator (no database required)
# Disable this for a private production deployment.
ENABLE_DEMO_ADMIN=true
DEMO_ADMIN_EMAIL=demo.admin@wheelmatedrive.in
DEMO_ADMIN_PASSWORD=DemoAdmin@2026
